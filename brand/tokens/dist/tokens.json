  "color.accent.source": {
    "type": "color",
    "description": "The one input colour. Default: Demido green (#68efaf). Overwrite --d-color-accent-source to change the accent everywhere.",
    "var": "--d-color-accent-source",
    "value": "oklch(0.86 0.15 160)",
    "hex": "#68efaf"
  },
  "color.accent.base": {
    "type": "color",
    "description": "The source, with its lightness held in a band that stays visible on this theme's background. On light the strength is eased a little so the colour stays inside what every screen can show.",
    "var": "--d-color-accent-base",
    "value": {
      "dark": "oklch(0.86 0.15 160)",
      "light": "oklch(0.56 0.126 160)"
    },
    "hex": {
      "dark": "#68efaf",
      "light": "#038a5a"
    },
    "derived": {
      "dark": "oklch(from var(--d-color-accent-source) clamp(0.74, l, 0.9) c h)",
      "light": "oklch(from var(--d-color-accent-source) clamp(0.42, l, 0.56) calc(c * 0.84) h)"
    }
  },
