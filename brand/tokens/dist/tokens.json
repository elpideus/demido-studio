      "dark": "#79febd",
      "light": "#027b50"
    },
    "derived": {
      "dark": "oklch(from var(--d-color-accent-base) calc(l + 0.045) c h)",
      "light": "oklch(from var(--d-color-accent-base) calc(l - 0.045) calc(c * 0.92) h)"
    }
  },
