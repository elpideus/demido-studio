{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Demido Studio",
  "version": "0.1.0",
  "identifier": "com.demido.studio",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Demido Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "title": "Demido Studio",
        "width": 440,
        "height": 264,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "copyright": "Copyright (c) 2026 Stefan Cucoranu",
    "shortDescription": "An LLM harness that makes small models behave.",
    "longDescription": "Demido Studio is a local-first LLM harness. Small models are guided rather than left to flounder, and every prompt, tool call and result is recorded in an append-only session log you can inspect and replay.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
