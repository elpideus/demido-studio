# dependencies
node_modules/
.pnpm-store/

# rust
target/

# build output
dist/
build/
*.tsbuildinfo
# ...except the brand's built tokens: the kit page and the app both read them, so a fresh copy of the
# repository must have them. The checks rebuild them and fail if they differ from their sources.
!brand/tokens/dist/

# local state
.env
.env.*
!.env.example
*.log
.shots/
.DS_Store
Thumbs.db

# editors and assistants (per-machine)
.claude/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# brand lab: the reports and the scripts are kept. The images are rebuilt by those scripts and stay out
# (38 MB of comparison sheets, and the raw captures behind them). See brand/explorations/lab/README.md.
brand/explorations/lab/color/sheets/*.png
brand/explorations/lab/type/out/**/*.png
brand/explorations/**/node_modules/
brand/explorations/**/renders/
brand/explorations/**/shots/

# Python bytecode, from running the trials in core/dev
__pycache__/
*.pyc
