{
  "name": "demido-studio",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "Stefan Cucoranu <elpideus@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:drive": "tauri dev --config src-tauri/tauri.drive.conf.json",
    "build": "tauri build",
    "tauri": "tauri",
    "dev:web": "pnpm --filter @demido/web dev",
    "build:web": "pnpm --filter @demido/web build",
    "typecheck": "pnpm --filter @demido/web typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:rules": "node scripts/check-rules.mjs",
    "drive": "node scripts/drive.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.1",
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@11.13.1"
}
