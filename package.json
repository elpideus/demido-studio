{
  "name": "demido-studio",
  "private": true,
  "version": "0.0.0",
  "description": "Demido Studio: a local-first, open-source AI harness that makes small models behave.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "brand:build": "node brand/build.mjs",
    "brand:serve": "python3 -m http.server 4173 --bind 127.0.0.1 --directory brand",
    "app:dev": "pnpm --filter @demido/web dev",
    "app:build": "pnpm --filter @demido/web build",
    "app:preview": "pnpm --filter @demido/web preview",
    "app:typecheck": "pnpm --filter @demido/web typecheck",
    "core:test": "cargo test --manifest-path core/Cargo.toml",
    "core:build": "cargo build --release --manifest-path core/Cargo.toml",
    "core:serve": "pnpm app:build && cargo run --manifest-path core/Cargo.toml -- serve --ui-dir apps/web/dist"
  },
  "devDependencies": {
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "lucide-static": "^1.76.0"
  }
}
