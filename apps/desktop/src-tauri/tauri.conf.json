{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Demido Studio",
  "mainBinaryName": "demido-desktop",
  "version": "0.1.0",
  "identifier": "studio.demido.desktop",
  "build": {
    "frontendDist": "../starting"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "capabilities": []
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
