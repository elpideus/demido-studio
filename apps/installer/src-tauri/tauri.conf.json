{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Demido Studio Setup",
  "mainBinaryName": "demido-setup",
  "version": "0.1.0",
  "identifier": "app.demido.setup",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Demido Studio Setup",
        "width": 900,
        "height": 620,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#191919",
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
